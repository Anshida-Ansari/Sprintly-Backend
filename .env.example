# ─── Server ────────────────────────────────────────────────────────────────────
PORT=2000

# ─── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sprintly?retryWrites=true&w=majority

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=<redis-host>
REDIS_PORT=<redis-port>
REDIS_PASSWORD=<redis-password>

# ─── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-app-password>

# ─── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECERET=<strong-random-secret>
REFRESH_TOKEN_SECERET=<strong-random-secret>
ACCESS_TOKEN_MAX_AGE=900
REFRESH_TOKEN_MAX_AGE=604800

# ─── Frontend ──────────────────────────────────────────────────────────────────
FRONTENT_URL=http://localhost:5173

# ─── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>
GITHUB_CALLBACK_URL=http://localhost:2000/api/github/callback

# ─── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<64-char-hex-string>

# ─── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
AWS_REGION=us-east-1
AWS_BUCKET_NAME=sprintly-task-attachements

# ─── AI Services ───────────────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
STRIPE_PRO_PRICE_ID=<your-price-id>
